# 独立域名使用根路径，PUBLIC_BASE_URL=https://mediary.example.com。
# 先只启用 HTTP 块完成 HTTP-01 验证，证书签发后再启用 HTTPS 块。
server {
    listen 80;
    listen [::]:80;
    server_name mediary.example.com;
    access_log off;
    error_log /dev/null;

    location /.well-known/acme-challenge/ {
        root /var/www/mediary-acme;
        try_files $uri =404;
    }
    location / {
        return 301 https://mediary.example.com$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name mediary.example.com;
    ssl_certificate /etc/letsencrypt/live/mediary/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mediary/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # OAuth 回调和授权表单可能含凭据，不能继承其他站点的请求日志。
    access_log off;
    error_log /dev/null;
    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 70s;
        proxy_read_timeout 70s;
        client_max_body_size 64k;
    }
}
