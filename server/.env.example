# Copy to .env on your server. Never send keys or service tokens in chat.
# MCP uses your ChatGPT conversation, without a model API key.
PUBLIC_BASE_URL=https://your-mcp.example.com/mediary
# Docker Compose sets DATA_DIR=/data and persists it in the mediary-data volume.
# For a local Node process, set an absolute private data directory.
# DATA_DIR=/absolute/private/path
# Optional legacy AI extraction: zhipu pins the official model; no fallback.
AI_PROVIDER=zhipu
ZHIPU_API_KEY=
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Enter this token in Android's ChatGPT draft settings and the OAuth login form.
# Never paste it into ChatGPT messages. It is NOT your provider API key.
MEDIARY_ACCESS_TOKEN=
HOST=127.0.0.1
PORT=8787
# Docker Compose publishes to localhost only. Change this if port 8787 is occupied.
MEDIARY_PORT=8787

# Optional Responses API: set AI_PROVIDER=openai and configure these values.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
